# Used by the web page and command-line converter.
PADDLEOCR_TOKEN=your-token-here
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
WEB_USERNAME=admin
WEB_PASSWORD=change-this-password

# Cloudflare R2（R2_ENDPOINT_URL 与 R2_ACCOUNT_ID 二选一）
R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket
R2_REGION=auto
R2_PREFIX=pdf-to-md

# 可选：桶的公开域名。配置后 Markdown 图片链接会改为公开 R2 URL。
# R2_PUBLIC_BASE_URL=https://files.example.com
